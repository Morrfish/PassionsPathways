{
  "name": "morris-mayhem-desktop",
  "productName": "Morris Mayhem",
  "version": "0.1.0",
  "description": "Morris Mayhem: a 2-4 player family platform fighter.",
  "author": "Passions Pathways",
  "main": "main.js",
  "scripts": {
    "start": "node copy-web.js && electron .",
    "prebuild": "node copy-web.js",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "org.passionspathways.morrismayhem",
    "files": ["main.js", "icon.png", "web/**"],
    "win": { "target": "portable", "icon": "icon.png", "signAndEditExecutable": false },
    "portable": { "artifactName": "MorrisMayhem.exe" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
