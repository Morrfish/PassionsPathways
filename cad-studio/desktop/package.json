{
  "name": "pathway-cad-desktop",
  "productName": "Pathway CAD",
  "version": "1.0.0",
  "description": "Pathway CAD: a student 3D part modeler.",
  "author": "Passions Pathways",
  "main": "main.js",
  "scripts": {
    "start": "node copy-app.js && electron .",
    "prebuild": "node copy-app.js",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "org.passionspathways.pathwaycad",
    "files": ["main.js", "app/**", "licenses/**"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "PathwayCAD.exe" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
